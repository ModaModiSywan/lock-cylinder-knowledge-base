---
// src/components/BottomInquiry.astro
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Inquire About High-Security Lock Cylinders",
  subtitle = "Have technical questions or custom master keying requirements? Submit your inquiry below and our engineering team will respond within 24 hours."
} = Astro.props;
---

<section class="inquiry-section" id="inquire">
  <div class="container">
    <div class="inquiry-wrapper">
      <div class="inquiry-header">
        <span class="inquiry-tag">DIRECT INQUIRY</span>
        <h2 class="inquiry-title">{title}</h2>
        <p class="inquiry-subtitle">{subtitle}</p>
      </div>

      <form id="bottom-inquiry-form" class="inquiry-form">
        <input type="hidden" name="source_page" id="source_page" value="" />

        <div class="form-grid">
          <!-- Name -->
          <div class="form-group">
            <label for="inquiry-name">Name <span class="required">*</span></label>
            <input 
              type="text" 
              id="inquiry-name" 
              name="name" 
              required 
              placeholder="Your Full Name" 
              class="form-input"
            />
          </div>

          <!-- Country -->
          <div class="form-group">
            <label for="inquiry-country">Country <span class="required">*</span></label>
            <input 
              type="text" 
              id="inquiry-country" 
              name="country" 
              required 
              placeholder="e.g. Germany, United States, UAE" 
              class="form-input"
            />
          </div>

          <!-- Email -->
          <div class="form-group full-width">
            <label for="inquiry-email">E-mail <span class="required">*</span></label>
            <input 
              type="email" 
              id="inquiry-email" 
              name="email" 
              required 
              placeholder="business@example.com" 
              class="form-input"
            />
          </div>

          <!-- Message -->
          <div class="form-group full-width">
            <label for="inquiry-message">Message <span class="required">*</span></label>
            <textarea 
              id="inquiry-message" 
              name="message" 
              rows="4" 
              required 
              placeholder="Specify cylinder type, profile standard (Euro/Mortise/Rim), security grade, or custom keying requirements..." 
              class="form-textarea"
            ></textarea>
          </div>
        </div>

        <div class="form-action">
          <button type="submit" id="submit-btn" class="submit-btn">
            <span class="btn-text">Submit Inquiry &rarr;</span>
            <span class="loading-spinner" style="display: none;">Submitting...</span>
          </button>
        </div>

        <!-- 状态反馈提示 -->
        <div id="form-feedback" class="form-feedback" style="display: none;"></div>
      </form>
    </div>
  </div>
</section>

<style>
  .inquiry-section {
    width: 100%;
    background-color: #0f172a;
    color: #f8fafc;
    padding: 4.5rem 0;
    margin-top: 3.5rem;
    border-top: 1px solid #1e293b;
  }

  .inquiry-wrapper {
    max-width: 800px;
    margin: 0 auto;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }

  .inquiry-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .inquiry-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .inquiry-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .inquiry-subtitle {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .inquiry-form {
    width: 100%;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group.full-width {
    grid-column: span 2;
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 0.4rem;
  }

  .required {
    color: #f43f5e;
  }

  .form-input, .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #f8fafc;
    font-size: 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form-action {
    margin-top: 1.5rem;
    text-align: right;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f97316;
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.85rem 2rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }

  .submit-btn:hover {
    background: #ea580c;
  }

  .submit-btn:disabled {
    background: #64748b;
    cursor: not-allowed;
  }

  .form-feedback {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 6px;
    font-size: 0.9rem;
    text-align: center;
  }

  .form-feedback.success {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid #22c55e;
    color: #4ade80;
  }

  .form-feedback.error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid #ef4444;
    color: #f87171;
  }

  @media (max-width: 640px) {
    .inquiry-section {
      padding: 3rem 0;
    }
    .inquiry-wrapper {
      padding: 1.5rem 1rem;
    }
    .form-grid {
      grid-template-columns: 1fr;
    }
    .form-group.full-width {
      grid-column: span 1;
    }
    .submit-btn {
      width: 100%;
    }
  }
</style>

<script>
  function setupInquiryForm() {
    const form = document.getElementById('bottom-inquiry-form') as HTMLFormElement;
    const sourcePageInput = document.getElementById('source_page') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const feedback = document.getElementById('form-feedback') as HTMLDivElement;

    if (!form || !submitBtn || !feedback) return;

    if (sourcePageInput) {
      sourcePageInput.value = window.location.href;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      submitBtn.disabled = true;
      const btnText = submitBtn.querySelector('.btn-text') as HTMLElement;
      const spinner = submitBtn.querySelector('.loading-spinner') as HTMLElement;
      if (btnText && spinner) {
        btnText.style.display = 'none';
        spinner.style.display = 'inline';
      }

      feedback.style.display = 'none';
      feedback.className = 'form-feedback';

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        country: formData.get('country'),
        email: formData.get('email'),
        message: formData.get('message'),
        source_page: formData.get('source_page') || window.location.href
      };

      try {
        const res = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await res.json();

        if (res.ok && result.success) {
          feedback.textContent = "Thank you! Your inquiry has been sent successfully. Our team will contact you shortly.";
          feedback.classList.add('success');
          feedback.style.display = 'block';
          form.reset();
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch (err: any) {
        feedback.textContent = err.message || "An error occurred while submitting. Please try again or email us directly.";
        feedback.classList.add('error');
        feedback.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        if (btnText && spinner) {
          btnText.style.display = 'inline';
          spinner.style.display = 'none';
        }
      }
    });
  }

  setupInquiryForm();
  document.addEventListener('astro:page-load', setupInquiryForm);
</script>