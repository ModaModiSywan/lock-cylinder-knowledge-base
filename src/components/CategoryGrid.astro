---

<section class="w-full py-12 bg-slate-50/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        Technical Knowledge Clusters
      </h2>
      <p class="mt-3 text-base text-slate-600 sm:text-lg">
        Explore architectural lock cylinders by mechanical engineering classification and standards.
      </p>
    </div>

    <!-- 6 大分类 Grid 容器 (带防溢出约束) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <a
          href={`/${cat.slug}/`}
          class="group relative overflow-hidden bg-white border border-slate-200/80 rounded-2xl p-7 shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300 flex flex-col justify-between min-w-0"
        >
          <!-- 1. 背景 SVG 工业线稿水印 (位于底层 z-0, 鼠标穿透, 默认 4% 透明度, Hover 呼吸放大) -->
          <div 
            class="absolute -right-6 -bottom-6 w-48 h-48 pointer-events-none transition-all duration-500 ease-out transform group-hover:scale-110 group-hover:-translate-x-2 group-hover:-translate-y-2 z-0"
            aria-hidden="true"
          >
            <svg
              viewBox={cat.viewBox}
              class="w-full h-full text-blue-600 opacity-[0.045] group-hover:opacity-[0.10] transition-opacity duration-300 fill-none stroke-current stroke-[2.5] stroke-linecap-round stroke-linejoin-round"
            >
              <path d={cat.svgPath} />
            </svg>
          </div>

          <!-- 2. 卡片主体内容 (z-10 确保文字不受背景影响) -->
          <div class="relative z-10">
            <span class="inline-block px-2.5 py-1 text-xs font-bold tracking-wider text-blue-700 bg-blue-50 border border-blue-100 rounded-md uppercase mb-4">
              {cat.badge}
            </span>

            <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors duration-200">
              {cat.title}
            </h3>

            <div class="text-sm font-medium text-slate-500 mb-3">
              {cat.subtitle}
            </div>

            <p class="text-sm text-slate-600 leading-relaxed">
              {cat.description}
            </p>
          </div>

          <!-- 3. 底部技术目录导航条与交互箭头 -->
          <div class="relative z-10 mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-sm font-semibold text-blue-600 group-hover:text-blue-700">
            <span>View Technical Directory</span>
            <svg 
              class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform duration-200" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>