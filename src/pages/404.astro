---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "404 - Page Not Found | Technical Knowledge Base";
const description = "The page or technical specification you requested could not be found. Explore our engineering database and product guides.";
---

<Layout title={title} description={description}>
  <main class="error-page-wrapper">
    <div class="container">
      <Breadcrumbs items={[{ name: '404 Not Found' }]} />

      <div class="error-card">
        <div class="error-badge">Error 404</div>
        <h1 class="error-title">Page Not Found</h1>
        <p class="error-description">
          Sorry, the engineering specification, article, or resource you are looking for has been moved, renamed, or is temporarily unavailable.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Back to Homepage
          </a>
          <a href="/search" class="btn btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            Search Technical Database
          </a>
        </div>

        <div class="quick-links-section">
          <h2 class="quick-links-heading">Popular Sections</h2>
          <div class="quick-links-grid">
            <a href="/" class="quick-link-card">
              <span class="link-title">All Knowledge Entries</span>
              <span class="link-arrow">&rarr;</span>
            </a>
            <a href="/search" class="quick-link-card">
              <span class="link-title">Real-Time Search</span>
              <span class="link-arrow">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .error-page-wrapper {
    min-height: calc(100vh - 160px);
    padding: 2.5rem 0 4rem;
    background-color: #f8fafc;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .error-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 3.5rem 2rem;
    text-align: center;
    max-width: 760px;
    margin: 1.5rem auto 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .error-badge {
    display: inline-block;
    background-color: #eff6ff;
    color: #2563eb;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }

  .error-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .error-description {
    font-size: 1.05rem;
    color: #64748b;
    line-height: 1.6;
    max-width: 580px;
    margin: 0 auto 2rem;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: #0f172a;
    color: #ffffff;
    border: 1px solid #0f172a;
  }

  .btn-primary:hover {
    background-color: #2563eb;
    border-color: #2563eb;
  }

  .btn-outline {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }

  .btn-outline:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
  }

  .quick-links-section {
    border-top: 1px solid #f1f5f9;
    padding-top: 2rem;
    text-align: left;
  }

  .quick-links-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #334155;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .quick-link-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: #1e293b;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .quick-link-card:hover {
    background-color: #ffffff;
    border-color: #2563eb;
    color: #2563eb;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.08);
  }

  .link-arrow {
    transition: transform 0.2s ease;
  }

  .quick-link-card:hover .link-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .error-card {
      padding: 2.25rem 1.25rem;
    }

    .error-title {
      font-size: 1.75rem;
    }

    .error-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>